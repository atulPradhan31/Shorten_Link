# Server Port
PORT=3000

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=trimurl_db
PGPOOL_SIZE=20
PGSSLMODE=disable

# Optional: Connection string alternative to granular variables
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/trimurl_db
